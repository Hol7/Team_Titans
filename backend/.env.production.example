# ========================================
# TMTT Backend - Configuration PRODUCTION
# ========================================
# IMPORTANT: Copier ce fichier vers .env sur le serveur de production
# Ne JAMAIS commit le fichier .env !

# ========================================
# DJANGO
# ========================================
SECRET_KEY=CHANGE-THIS-TO-RANDOM-50-CHARS-SECRET-KEY
DEBUG=False
ALLOWED_HOSTS=tmtt.com,www.tmtt.com,api.tmtt.com

# ========================================
# DATABASE - PostgreSQL (production)
# ========================================
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=tmtt_production
DATABASE_USER=tmtt_user
DATABASE_PASSWORD=CHANGE-THIS-STRONG-PASSWORD
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Alternative: MySQL
# DATABASE_ENGINE=django.db.backends.mysql
# DATABASE_NAME=tmtt_production
# DATABASE_USER=tmtt_user
# DATABASE_PASSWORD=CHANGE-THIS-STRONG-PASSWORD
# DATABASE_HOST=localhost
# DATABASE_PORT=3306

# ========================================
# COMPTE GCA - Super administrateur
# ========================================
GCA_USERNAME=gca_admin
GCA_EMAIL=admin@tmtt.com
GCA_PASSWORD=CHANGE-THIS-STRONG-PASSWORD
GCA_FIRST_NAME=GCA
GCA_LAST_NAME=Administrator
GCA_PHONE=+33145456598

# ========================================
# JWT - Authentification
# ========================================
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=1
JWT_ROTATE_REFRESH_TOKENS=True
JWT_BLACKLIST_AFTER_ROTATION=True

# ========================================
# CORS - Domaines autorisés
# ========================================
CORS_ALLOWED_ORIGINS=https://tmtt.com,https://www.tmtt.com,https://app.tmtt.com

# ========================================
# REDIS - Cache et sessions (REQUIS)
# ========================================
REDIS_URL=redis://:REDIS-PASSWORD@localhost:6379/0

# ========================================
# EMAIL - SMTP Production
# ========================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@tmtt.com
EMAIL_HOST_PASSWORD=GMAIL-APP-PASSWORD
DEFAULT_FROM_EMAIL=noreply@tmtt.com

# SendGrid (alternative recommandée)
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=SENDGRID-API-KEY
# DEFAULT_FROM_EMAIL=noreply@tmtt.com

# ========================================
# SECURITY - Protection maximale
# ========================================
DEFENDER_LOGIN_FAILURE_LIMIT=3
DEFENDER_COOLOFF_TIME=600
DEFENDER_STORE_ACCESS_ATTEMPTS=True
DEFENDER_ACCESS_ATTEMPT_EXPIRATION=168

AXES_FAILURE_LIMIT=3
AXES_COOLOFF_TIME=2
AXES_LOCK_OUT_AT_FAILURE=True
AXES_USE_USER_AGENT=True

RATELIMIT_ENABLE=True

SESSION_COOKIE_AGE=43200
SESSION_EXPIRE_AT_BROWSER_CLOSE=True

# ========================================
# HTTPS/SSL - REQUIS en production
# ========================================
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ========================================
# LOGGING
# ========================================
LOG_LEVEL=WARNING

# ========================================
# STORAGE - AWS S3 (recommandé)
# ========================================
USE_S3=True
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_STORAGE_BUCKET_NAME=tmtt-production-bucket
AWS_S3_REGION_NAME=eu-west-3
AWS_S3_CUSTOM_DOMAIN=cdn.tmtt.com

STATIC_URL=/static/
MEDIA_URL=/media/
MEDIA_ROOT=/var/www/tmtt/media

# ========================================
# CELERY - Tâches asynchrones (REQUIS)
# ========================================
CELERY_BROKER_URL=redis://:REDIS-PASSWORD@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:REDIS-PASSWORD@localhost:6379/1
CELERY_ACCEPT_CONTENT=json
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_TIMEZONE=UTC

# ========================================
# MONITORING - Sentry (REQUIS)
# ========================================
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.2

# ========================================
# THIRD-PARTY SERVICES
# ========================================
# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=YOUR-GOOGLE-CLIENT-ID.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOOGLE-CLIENT-SECRET

# Stripe (paiements)
STRIPE_PUBLIC_KEY=pk_live_YOUR-STRIPE-PUBLIC-KEY
STRIPE_SECRET_KEY=sk_live_YOUR-STRIPE-SECRET-KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR-WEBHOOK-SECRET

# Twilio (SMS)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+33612345678

# ========================================
# APPLICATION - Configuration TMTT
# ========================================
MAX_TEAM_MEMBERS=100
ATTENDANCE_GRACE_PERIOD_MINUTES=10
REPORT_RETENTION_DAYS=730
ENABLE_NOTIFICATIONS=True
NOTIFICATION_EMAIL_ENABLED=True
NOTIFICATION_SMS_ENABLED=True
