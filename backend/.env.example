# ========================================
# TMTT Backend - Configuration DÉVELOPPEMENT
# ========================================
# IMPORTANT: Copier ce fichier vers .env et personnaliser les valeurs
# Ne JAMAIS commit le fichier .env !

# ========================================
# DJANGO
# ========================================
SECRET_KEY=dev-secret-key-change-this
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ========================================
# DATABASE - SQLite (développement)
# ========================================
DATABASE_ENGINE=django.db.backends.sqlite3
DATABASE_NAME=db.sqlite3
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=
DATABASE_PORT=

# ========================================
# COMPTE GCA - Super administrateur
# ========================================
GCA_USERNAME=gca
GCA_EMAIL=gca@tmtt.com
GCA_PASSWORD=gca123456
GCA_FIRST_NAME=GCA
GCA_LAST_NAME=User
GCA_PHONE=0145456598

# ========================================
# JWT - Authentification
# ========================================
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_ROTATE_REFRESH_TOKENS=True
JWT_BLACKLIST_AFTER_ROTATION=True

# ========================================
# CORS - Frontend local
# ========================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:3030,http://localhost:3030

# ========================================
# REDIS - Optionnel en dev
# ========================================
REDIS_URL=

# ========================================
# EMAIL - Console (développement)
# ========================================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USE_TLS=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@tmtt.com

# ========================================
# SECURITY - Protection
# ========================================
DEFENDER_LOGIN_FAILURE_LIMIT=5
DEFENDER_COOLOFF_TIME=300
DEFENDER_STORE_ACCESS_ATTEMPTS=True
DEFENDER_ACCESS_ATTEMPT_EXPIRATION=24

AXES_FAILURE_LIMIT=5
AXES_COOLOFF_TIME=1
AXES_LOCK_OUT_AT_FAILURE=True
AXES_USE_USER_AGENT=True

RATELIMIT_ENABLE=True

SESSION_COOKIE_AGE=86400
SESSION_EXPIRE_AT_BROWSER_CLOSE=True

# ========================================
# LOGGING
# ========================================
LOG_LEVEL=DEBUG

# ========================================
# STORAGE - Local
# ========================================
STATIC_URL=/static/
MEDIA_URL=/media/
MEDIA_ROOT=media
USE_S3=False

# ========================================
# CELERY - Optionnel
# ========================================
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ========================================
# MONITORING - Désactivé en dev
# ========================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ========================================
# THIRD-PARTY SERVICES - Développement
# ========================================
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ========================================
# APPLICATION - Configuration TMTT
# ========================================
MAX_TEAM_MEMBERS=50
ATTENDANCE_GRACE_PERIOD_MINUTES=15
REPORT_RETENTION_DAYS=365
ENABLE_NOTIFICATIONS=True
NOTIFICATION_EMAIL_ENABLED=True
NOTIFICATION_SMS_ENABLED=False
